# Development only. Do not use customer repositories or production credentials.
AIP_ENVIRONMENT=development
AIP_DATABASE_URL=postgresql+psycopg://aip:local_only@localhost:54329/aip
AIP_DEV_TENANT=local-tenant
AIP_DEV_ACTOR=local-developer
AIP_DEV_TOKEN=
# Hosted mode additionally requires an HTTPS OIDC issuer/JWKS, API audience,
# migrated PostgreSQL and an operator bootstrapped owner membership.
# AIP_OIDC_ISSUER=https://issuer.example.com/
# AIP_OIDC_AUDIENCE=ai-platform-api
# AIP_OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
AIP_ARTIFACT_DIR=./artifacts
